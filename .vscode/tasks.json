{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Current JS File",
      "type": "shell",
      "command": "node",
      "args": ["${file}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
